# Forma dos Secrets do identity que o overlay hmg espera no namespace. Não é resource
# do kustomization: em homologação eles vêm de um ExternalSecret/SealedSecret com
# os mesmos nomes (infra/k8s/overlays/hmg/secrets.example.yaml.tmpl).
apiVersion: v1
kind: Secret
metadata:
  name: identity
type: Opaque
stringData:
  PG_DSN: postgres://identity:REPLACE_ME@postgres.hmg.internal:5432/identity?sslmode=require
  KAFKA_BROKERS: kafka-0.hmg.internal:9093,kafka-1.hmg.internal:9093
  # Principal SASL do contexto. ACL exigida: write e describe em
  # identity.events e identity.events.dlq (ADR-052).
  KAFKA_SASL_USERNAME: identity
  KAFKA_SASL_PASSWORD: REPLACE_ME
---
# Chave HMAC dos identificadores fiscais, lida só pelo api: no mínimo 32 bytes
# e sem rotação nesta versão, porque os hashes guardados não podem ser
# recalculados (IDENTITY_IDENTIFIER_HMAC_KEY_VERSION no ConfigMap).
apiVersion: v1
kind: Secret
metadata:
  name: identity-identifier-key
type: Opaque
stringData:
  IDENTITY_IDENTIFIER_HMAC_KEY: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: identity-grpc-tls
type: kubernetes.io/tls
stringData:
  tls.crt: REPLACE_ME
  tls.key: REPLACE_ME
