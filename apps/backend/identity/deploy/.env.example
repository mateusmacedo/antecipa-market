# Processo do identity no host, contra a infra local (infra/local).
# Copie para deploy/.env e carregue antes do target:
#   set -a; . apps/backend/identity/deploy/.env; set +a; pnpm nx run identity:serve-api
# Fica fora da raiz do projeto porque o Nx carrega o `.env` dela em todo target,
# inclusive nos testes, que usam a infra de testes do `.env.example` da raiz.
OTEL_SERVICE_NAME=identity
OTEL_RESOURCE_ATTRIBUTES=service.version=local,service.instance.id=identity-local,deployment.environment.name=local
PG_DSN=postgres://identity:identity-local@localhost:5432/identity?sslmode=disable
MIGRATE=true
GRPC_ADDR=127.0.0.1:9194
GRPC_INSECURE=true
KAFKA_BROKERS=localhost:9092
KAFKA_INSECURE=true
KAFKA_GROUP=identity
KAFKA_IDENTITY_TOPIC=identity.events
KAFKA_IDENTITY_DLQ=identity.events.dlq
# Chave HMAC dos identificadores fiscais, sintética e só do host local; nunca
# rotaciona nesta versão, porque os hashes guardados não podem ser recalculados.
IDENTITY_IDENTIFIER_HMAC_KEY=identity-local-identifier-hmac-key-0001
IDENTITY_IDENTIFIER_HMAC_KEY_VERSION=1
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_LOGS_EXPORTER=otlp
OTEL_PROPAGATORS=tracecontext
OTEL_GO_X_OBSERVABILITY=true
OTEL_BSP_EXPORT_TIMEOUT=3000
OTEL_BLRP_EXPORT_TIMEOUT=3000
LOG_LEVEL=debug
