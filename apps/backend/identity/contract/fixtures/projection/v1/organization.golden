  },
  "cases": [
    {
      "name": "register-accepted",
      "doc": "Ramo Accepted de Register: CNPJ alfanumérico (ADR-021); a organização nasce active com createdAt = at, e o organization-registered leva hash e máscara, nunca o identificador em claro.",
      "state_before": {
        "organization": "org-1",
        "kinds": "",
        "jurisdiction": "",
        "tax_id_type": "",
        "tax_id": "",
        "tax_id_hash": "",
        "tax_id_hash_key_version": "0",
        "tax_id_masked": "",
        "legal_name": "",
        "trade_name": "",
        "status": "new",
        "created_at": "0"
      },
      "command": {
        "upr": "register",
        "kinds": "client",
        "jurisdiction": "BR",
        "tax_id_type": "cnpj",
        "tax_id": "12ABC34501DE35",
        "tax_id_hash": "4a455609da3a3d6d689b65257f38532e3868396abc39d3b92311b18489f169dc",
        "tax_id_hash_key_version": "1",
        "legal_name": "Recebiveis Sinteticos Ltda",
        "trade_name": "Sintetica",
        "at": "1755432000000000000"
      },
      "expected": {
        "branch": "accepted",
        "response": {
          "organization": "org-1"
        },
        "events": [
          {
            "name": "identity-organization.organization.registered",
            "fields": {
              "organization": "org-1",
              "kinds": "client",
              "jurisdiction": "BR",
              "tax_id_type": "cnpj",
              "tax_id_hash": "4a455609da3a3d6d689b65257f38532e3868396abc39d3b92311b18489f169dc",
              "tax_id_masked": "**.***.***/**DE-35",
              "at": "1755432000000000000"
            }
          }
        ],
        "state_after": {
          "organization": "org-1",
          "kinds": "client",
          "jurisdiction": "BR",
          "tax_id_type": "cnpj",
          "tax_id": "12ABC34501DE35",
          "tax_id_hash": "4a455609da3a3d6d689b65257f38532e3868396abc39d3b92311b18489f169dc",
          "tax_id_hash_key_version": "1",
          "tax_id_masked": "**.***.***/**DE-35",
          "legal_name": "Recebiveis Sinteticos Ltda",
          "trade_name": "Sintetica",
          "status": "active",
          "created_at": "1755432000000000000"
        }
      }
