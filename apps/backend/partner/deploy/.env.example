# Processo do partner no host, contra a infra local (infra/local).
# Copie para deploy/.env e carregue antes do target:
#   set -a; . apps/backend/partner/deploy/.env; set +a; pnpm nx run partner:serve-api
# Fica fora da raiz do projeto porque o Nx carrega o `.env` dela em todo target,
# inclusive nos testes, que usam a infra de testes do `.env.example` da raiz.
OTEL_SERVICE_NAME=partner
OTEL_RESOURCE_ATTRIBUTES=service.version=local,service.instance.id=partner-local,deployment.environment.name=local
PG_DSN=postgres://partner:partner-local@localhost:5432/partner?sslmode=disable
GRPC_ADDR=127.0.0.1:9195
GRPC_INSECURE=true
KAFKA_BROKERS=localhost:9092
KAFKA_INSECURE=true
KAFKA_GROUP=partner
KAFKA_PARTNER_TOPIC=partner.events
KAFKA_PARTNER_DLQ=partner.events.dlq
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_LOGS_EXPORTER=otlp
OTEL_PROPAGATORS=tracecontext
OTEL_GO_X_OBSERVABILITY=true
OTEL_BSP_EXPORT_TIMEOUT=3000
OTEL_BLRP_EXPORT_TIMEOUT=3000
LOG_LEVEL=debug
