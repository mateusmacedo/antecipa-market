  "cases": [
    {
      "name": "register-accepted",
      "doc": "Ramo Accepted de Register: organização com kind funder registrada como financiador; o parceiro nasce prospect e PartnerRegistered é emitido.",
      "state_before": {
        "partner": "prt-1",
        "organization": "",
        "role": "",
        "status": "",
        "registered_at": "0",
        "stage_changed_at": "0",
        "stage_reason": "",
        "offboarding_started_at": "0"
      },
      "command": {
        "upr": "register",
        "organization": "org-1",
        "role": "funder",
        "organization_found": "true",
        "organization_kinds": "funder",
        "at": "1755432000000000000"
      },
      "expected": {
        "branch": "accepted",
        "response": {
          "partner": "prt-1"
        },
        "events": [
          {
            "name": "partner-management.partner.registered",
            "fields": {
              "partner": "prt-1",
              "organization": "org-1",
              "role": "funder",
              "at": "1755432000000000000"
            }
          }
        ],
        "state_after": {
          "partner": "prt-1",
          "organization": "org-1",
          "role": "funder",
          "status": "prospect",
          "registered_at": "1755432000000000000",
          "stage_changed_at": "1755432000000000000",
          "stage_reason": "",
          "offboarding_started_at": "0"
        }
      }
    },
