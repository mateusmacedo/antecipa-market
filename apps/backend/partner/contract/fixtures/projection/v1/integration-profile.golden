    {
      "name": "raise-expiry-alert-accepted",
      "doc": "Ramo Accepted de RaiseExpiryAlert: o certificado vence em 25 dias, o limiar de 30 é registrado e PartnerCertificateExpiring é emitido.",
      "state_before": {
        "profile": "ipf-1",
        "partner": "prt-1",
        "environment": "production",
        "version": "1",
        "supersedes": "",
        "change_kind": "initial",
        "protocols": "https,mtls",
        "endpoint": "https://partner.example/api",
        "schema_version": "v3",
        "secret_ref": "vault://partners/prt-1/api-key",
        "certificate_ref": "cert-1",
        "certificate_expires_at": "1757592000000000000",
        "effective_from": "1755432000000000000",
        "last_alerted_threshold_days": "0"
      },
      "command": {
        "upr": "raise-expiry-alert",
        "threshold_days": "30",
        "at": "1755432000000000000"
      },
      "expected": {
        "branch": "accepted",
        "response": {
          "profile": "ipf-1"
        },
        "events": [
          {
            "name": "partner-management.integration-profile.certificate-expiring",
            "fields": {
              "profile": "ipf-1",
              "partner": "prt-1",
              "environment": "production",
              "certificate_expires_at": "1757592000000000000",
              "threshold_days": "30",
              "at": "1755432000000000000"
            }
          }
        ],
        "state_after": {
          "profile": "ipf-1",
          "partner": "prt-1",
          "environment": "production",
          "version": "1",
          "supersedes": "",
          "change_kind": "initial",
          "protocols": "https,mtls",
          "endpoint": "https://partner.example/api",
          "schema_version": "v3",
          "secret_ref": "vault://partners/prt-1/api-key",
          "certificate_ref": "cert-1",
          "certificate_expires_at": "1757592000000000000",
          "effective_from": "1755432000000000000",
          "last_alerted_threshold_days": "30"
        }
      }
    },
