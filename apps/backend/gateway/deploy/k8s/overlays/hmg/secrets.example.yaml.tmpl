# Forma dos Secrets do gateway que o overlay hmg espera no namespace. Não é resource
# do kustomization: em homologação eles vêm de um ExternalSecret/SealedSecret com
# os mesmos nomes (infra/k8s/overlays/hmg/secrets.example.yaml.tmpl).
apiVersion: v1
kind: Secret
metadata:
  name: gateway
type: Opaque
stringData:
  PG_DSN: postgres://gateway:REPLACE_ME@postgres.hmg.internal:5432/gateway?sslmode=require
  KAFKA_BROKERS: kafka-0.hmg.internal:9093,kafka-1.hmg.internal:9093
  # Principal SASL do contexto. ACL exigida: write e describe em
  # gateway.events, gateway.events.dlq, gateway.dispatch, gateway.dispatch.dlq,
  # gateway.interactions, gateway.interactions.dlq, gateway.normalizations,
  # gateway.normalizations.dlq e partner.events.dlq; read e describe em
  # partner.events e no grupo gateway, e em cada canal próprio no grupo de
  # mesmo nome: gateway.events, gateway.dispatch, gateway.interactions e
  # gateway.normalizations (ADR-052).
  KAFKA_SASL_USERNAME: gateway
  KAFKA_SASL_PASSWORD: REPLACE_ME
  # Bucket do bruto das interações: versionado, com Object Lock e sem retenção
  # padrão, cifrado pela chave KMS do ARN (sem ele, AES256); decisão 16 da
  # SPEC-N1X148AW. A role do pod (cadeia padrão do SDK) recebe s3:PutObject,
  # s3:GetObjectVersion, s3:GetObjectRetention e s3:GetObjectLegalHold em
  # <bucket>/tenant/*, s3:GetBucketVersioning e
  # s3:GetBucketObjectLockConfiguration no bucket, e kms:GenerateDataKey e
  # kms:Decrypt na chave; nunca s3:BypassGovernanceRetention.
  S3_BUCKET: REPLACE_ME
  AWS_REGION: REPLACE_ME
  S3_KMS_KEY_ARN: REPLACE_ME
---
# DSN da role migradora, dona do banco (ADR-063). Só o Deployment do api o
# referencia: o Secret gateway entra também no relay.
apiVersion: v1
kind: Secret
metadata:
  name: gateway-migrator
type: Opaque
stringData:
  PG_MIGRATE_DSN: postgres://gateway_migrator:REPLACE_ME@postgres.hmg.internal:5432/gateway?sslmode=verify-full&channel_binding=require
---
apiVersion: v1
kind: Secret
metadata:
  name: gateway-grpc-tls
type: kubernetes.io/tls
stringData:
  tls.crt: REPLACE_ME
  tls.key: REPLACE_ME
