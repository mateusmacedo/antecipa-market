# Processo do gateway no host, contra a infra local (infra/local).
# Copie para deploy/.env e carregue antes do target:
#   set -a; . apps/backend/gateway/deploy/.env; set +a; pnpm nx run gateway:serve-api
# Fica fora da raiz do projeto porque o Nx carrega o `.env` dela em todo target,
# inclusive nos testes, que usam a infra de testes do `.env.example` da raiz.
OTEL_SERVICE_NAME=gateway
OTEL_RESOURCE_ATTRIBUTES=service.version=local,service.instance.id=gateway-local,deployment.environment.name=local
PG_DSN=postgres://gateway:gateway-local@localhost:5432/gateway?sslmode=disable
GRPC_ADDR=127.0.0.1:9196
GRPC_INSECURE=true
KAFKA_BROKERS=localhost:9092
KAFKA_INSECURE=true
KAFKA_GROUP=gateway
KAFKA_GATEWAY_TOPIC=gateway.events
KAFKA_GATEWAY_DLQ=gateway.events.dlq
KAFKA_GATEWAY_DISPATCH_TOPIC=gateway.dispatch
KAFKA_GATEWAY_DISPATCH_DLQ=gateway.dispatch.dlq
KAFKA_GATEWAY_INTERACTIONS_TOPIC=gateway.interactions
KAFKA_GATEWAY_INTERACTIONS_DLQ=gateway.interactions.dlq
KAFKA_GATEWAY_NORMALIZATIONS_TOPIC=gateway.normalizations
KAFKA_GATEWAY_NORMALIZATIONS_DLQ=gateway.normalizations.dlq
KAFKA_PARTNER_TOPIC=partner.events
KAFKA_PARTNER_DLQ=partner.events.dlq
KAFKA_GATEWAY_EVENTS_GROUP=gateway.events
KAFKA_GATEWAY_DISPATCH_GROUP=gateway.dispatch
KAFKA_GATEWAY_INTERACTIONS_GROUP=gateway.interactions
KAFKA_GATEWAY_NORMALIZATIONS_GROUP=gateway.normalizations
# Bruto das interações no floci da infra local (api e consumer); o bucket,
# versionado, com Object Lock e sem retenção padrão, é provisionado fora do contexto.
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=gateway-interactions
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_INSECURE=true
S3_PATH_STYLE=true
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_LOGS_EXPORTER=otlp
OTEL_PROPAGATORS=tracecontext
OTEL_GO_X_OBSERVABILITY=true
OTEL_BSP_EXPORT_TIMEOUT=3000
OTEL_BLRP_EXPORT_TIMEOUT=3000
LOG_LEVEL=debug
