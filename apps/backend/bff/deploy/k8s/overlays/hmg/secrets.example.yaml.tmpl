# Forma dos Secrets do bff no hmg; não é resource: vêm de ExternalSecret/SealedSecret com os mesmos nomes.

# CA que emitiu o certificado do `api` do identity; é o que o BFF confia.
apiVersion: v1
kind: Secret
metadata:
  name: bff-grpc-ca
type: Opaque
stringData:
  ca.crt: REPLACE_ME
---
# Certificado de cliente do BFF, com a URI spiffe://dmpf/bff no SAN — é a
# identidade que os `api` confiam (GRPC_TRUSTED_CLIENTS).
apiVersion: v1
kind: Secret
metadata:
  name: bff-grpc-client
type: kubernetes.io/tls
stringData:
  tls.crt: REPLACE_ME
  tls.key: REPLACE_ME
---
# Servidor de autorização que o BFF verifica (apps/backend/bff/README.md). O
# emissor, a audiência e a claim de tenant dependem do realm de homologação.
apiVersion: v1
kind: Secret
metadata:
  name: bff-oidc
type: Opaque
stringData:
  OIDC_ISSUER: https://REPLACE_ME/realms/dmpf
  OIDC_AUDIENCE: REPLACE_ME
  OIDC_TENANT_CLAIM: REPLACE_ME
