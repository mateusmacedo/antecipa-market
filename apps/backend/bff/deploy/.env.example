# BFF no host, contra o identity rodando no host com o deploy/.env.example dele
# (gRPC sem TLS, porta 9194). Gere deploy/.env com `pnpm nx run bff:deploy-env`
# e carregue antes do target:
#   set -a; . apps/backend/bff/deploy/.env; set +a; pnpm nx run bff:serve
# O caminho do OpenAPI é relativo a apps/backend/bff, o cwd do serve.
OTEL_SERVICE_NAME=bff
OTEL_RESOURCE_ATTRIBUTES=service.version=local,service.instance.id=bff-local,dmpf.process.role=api,deployment.environment.name=local
HTTP_ADDR=127.0.0.1:8080
ADMIN_ADDR=127.0.0.1:8090
IDENTITY_GRPC_TARGET=dns:///127.0.0.1:9194
GRPC_INSECURE=true
AUTH_DEV_MOCK=true
# Para trocar o mock pelo realm, remova AUTH_DEV_MOCK e descomente:
# OIDC_ISSUER=http://keycloak.localhost:8180/realms/dmpf
# OIDC_AUDIENCE=dmpf-bff
# OIDC_TENANT_CLAIM=organization.*.tenant_id
REDIS_URL=redis://revocation:dmpf-local-revocation@localhost:6379/0
OPENAPI_IDENTITY_PATH=../identity/contract/openapi/v1/openapi.yaml
CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_LOGS_EXPORTER=otlp
OTEL_PROPAGATORS=tracecontext
OTEL_GO_X_OBSERVABILITY=true
OTEL_BSP_EXPORT_TIMEOUT=3000
OTEL_BLRP_EXPORT_TIMEOUT=3000
LOG_LEVEL=debug
